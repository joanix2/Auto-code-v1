#!/bin/bash
# Pre-push hook — lance les tests backend avant chaque push.

set -euo pipefail

ROOT="$(git rev-parse --show-toplevel 2>/dev/null || echo '.')"
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

cd "$ROOT/backend"

echo -e "${YELLOW}🧪 Tests backend...${NC}"

EXIT_CODE=0
if [ -x ".venv/bin/pytest" ]; then
    .venv/bin/pytest tests/ -q --timeout=30 2>&1 || EXIT_CODE=$?
elif command -v uv &>/dev/null; then
    uv run pytest tests/ -q --timeout=30 2>&1 || EXIT_CODE=$?
else
    echo -e "${YELLOW}⚠️  pytest non trouvé — tests ignorés${NC}"
    exit 0
fi

if [ $EXIT_CODE -ne 0 ]; then
    echo -e "${RED}❌ Tests échoués — push annulé${NC}"
    exit 1
fi

echo -e "${GREEN}✅ Tests OK${NC}"
