#!/bin/bash
# Pre-commit hook — corrige le code automatiquement (ruff fix + format),
# vérifie la cohérence du diagramme, et guide le commit.

set -euo pipefail

ROOT="$(git rev-parse --show-toplevel 2>/dev/null || echo '.')"
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'
ERRORS=0

# ── 1. Ruff auto-fix + format ────────────────────────
RUFF="$ROOT/backend/.venv/bin/ruff"
if [ -x "$RUFF" ]; then
    cd "$ROOT/backend"

    echo -e "${YELLOW}🔧 Ruff auto-fix...${NC}"
    "$RUFF" check --fix --quiet src/ tests/ 2>/dev/null || true

    echo -e "${YELLOW}🎨 Ruff format...${NC}"
    "$RUFF" format --quiet src/ tests/ 2>/dev/null || true

    # Re-stager les fichiers modifiés par ruff
    cd "$ROOT"
    git add -u 2>/dev/null || true
else
    echo -e "${YELLOW}⚠️  Ruff non trouvé — correction ignorée${NC}"
fi

# ── 2. Diagramme cohérence ─────────────────────────
DIAGRAM="$ROOT/architecture_diagram.md"
if [ -f "$DIAGRAM" ]; then
    CLASSES=$(grep -oP 'class \K\w+' "$DIAGRAM" | grep -v '<<enumeration>>' | grep -v '^shadcn_' | sort -u || true)
    for cls in $CLASSES; do
        FOUND=$(grep -r \
        "^class ${cls}\b\|^class ${cls}(\|^export.*class ${cls}\b\|^export.*abstract class ${cls}\b\|^interface ${cls}\b\|^export interface ${cls}\b\|^export function ${cls}\b\|^export const ${cls}\b" \
        --include="*.py" --include="*.ts" --include="*.tsx" \
        "$ROOT/backend/src/" "$ROOT/backend/tests/" \
        "$ROOT/frontend/src/" 2>/dev/null | head -1 || true)
        if [ -z "$FOUND" ]; then
            echo -e "${YELLOW}⚠️  Classe '${cls}' dans le diagramme mais absente du code${NC}"
            ERRORS=$((ERRORS + 1))
        fi
    done
fi

# ── 3. Bilan ─────────────────────────────────────────
STAGED=$(git diff --cached --stat 2>/dev/null | tail -1 | awk '{print $1}')
echo -e "${GREEN}📦 ${STAGED:-0} fichier(s) stagé(s)${NC}"

if [ $ERRORS -gt 0 ]; then
    echo -e "${RED}⚠️  ${ERRORS} classe(s) manquante(s) dans le diagramme${NC}"
    echo -e "${YELLOW}→ @commit-agent ou modifie architecture_diagram.md${NC}"
fi

echo -e "${GREEN}✅ Prêt pour commit${NC}"
echo -e "${YELLOW}👉 git commit -m \"message\"${NC}"
