#!/bin/bash
# Pre-commit hook — vérifie que toutes les classes du diagramme
# architecture_diagram.md existent dans le code.
# Installé avec : git config core.hooksPath .githooks

set -euo pipefail

DIAGRAM="architecture_diagram.md"
RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m'
ROOT="$(git rev-parse --show-toplevel 2>/dev/null || echo '.')"
FILE="$ROOT/$DIAGRAM"

[ -f "$FILE" ] || { echo -e "${YELLOW}⚠️  $DIAGRAM introuvable${NC}"; exit 0; }

# Extraire les noms de classes (exclure les enums, commentaires, légendes)
CLASSES=$(grep -oP 'class \K\w+' "$FILE" | grep -v '<<enumeration>>' | sort -u || true)

ERRORS=0
for cls in $CLASSES; do
    # Chercher dans tous les .py du projet
    FOUND=$(grep -r "^class ${cls}\b\|^class ${cls}(" --include="*.py" "$ROOT/backend/src/" "$ROOT/backend/tests/" 2>/dev/null | head -1 || true)
    if [ -z "$FOUND" ]; then
        echo -e "${YELLOW}⚠️  Classe '${cls}' dans le diagramme mais absente du code${NC}"
        ERRORS=$((ERRORS + 1))
    fi
done

if [ $ERRORS -gt 0 ]; then
    echo -e "${RED}❌ ${ERRORS} classe(s) manquante(s)${NC}"
    echo "   Mets à jour le diagramme ou le code."
    exit 1
fi

echo "✅ Diagramme cohérent avec le code"
